generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  username  String
  tag       Int
  email     String   @unique
  avatar    String?
  bio       String?
  password  String
  createdAt DateTime @default(now())
}
